<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Haus of Bakery</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #fff7f0;
        }

        header {
            background-color: #8b4513;
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            background-color: #d2691e;
            padding: 10px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }

        .container {
            padding: 25px;
        }

        h2 {
            color: #8b4513;
            text-align: center;
        }

        .products {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card {
            background-color: white;
            width: 260px;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            overflow: hidden;
            text-align: center;
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .card h3 {
            margin: 10px 0 5px;
            color: #8b4513;
        }

        .card p {
            padding: 0 12px;
            font-size: 14px;
        }

        .price {
            font-weight: bold;
            color: #d2691e;
            margin-bottom: 15px;
        }

        footer {
            background-color: #8b4513;
            color: white;
            text-align: center;
            padding: 12px;
            margin-top: 30px;
        }
    </style>
</head>
<body>

<header>
    <h1>Haus of Bakery</h1>
    <p>Fresh • Handmade • Delicious</p>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Menu</a>
    <a href="#">Contact</a>
</nav>

<div class="container">

    <h2>Our Special Items</h2>

    <div class="products">

        <div class="card">
            <img src="cake.jpg" alt="Chocolate Cake">
            <h3>Chocolate Cake</h3>
            <p>Rich, moist chocolate cake perfect for celebrations.</p>
            <p class="price">Rs. 1200</p>
        </div>

        <div class="card">
            <img src="bread.jpg" alt="Fresh Bread">
            <h3>Fresh Bread</h3>
            <p>Soft and healthy bread baked fresh every morning.</p>
            <p class="price">Rs. 150</p>
        </div>

        <div class="card">
            <img src="cupcake.jpg" alt="Cupcakes">
            <h3>Cupcakes</h3>
            <p>Colorful cupcakes with creamy toppings.</p>
            <p class="price">Rs. 80 each</p>
        </div>

    </div>

</div>

<footer>
    <p>© 2026 Haus of Bakery | All Rights Reserved</p>
</footer>

</body>
</html>
